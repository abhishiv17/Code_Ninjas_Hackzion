# ---- REQUIRED ----
GROQ_API_KEY=your_groq_api_key_here

# ---- DATABASE ----
# SQLite (default - zero setup required for local dev / hackathon)
DATABASE_URL=sqlite:///./smarthighway.db

# PostgreSQL (optional - use with Docker Compose)
# DATABASE_URL=postgresql://admin:admin123@localhost:5432/smarthighway

# ---- OPTIONAL ----
SECRET_KEY=your_jwt_secret_key_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# ---- MEMORY OPTIMIZATION ----
# Set to true to disable local ChromaDB and Scikit-Learn models on startup
# Highly recommended for Render Free Tier (512MB RAM Limit)
DISABLE_ML=true

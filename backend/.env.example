# Backend Environment Configuration
# Copy this to .env and fill in your actual API key

# Groq API Key (required for LLM-based ticket analysis)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# The backend will automatically detect this key on startup.
# If not provided:
# - /analyze endpoint returns mock responses (keyword-based fallback)
# - /predict-root-cause endpoint works normally (uses trained ML model)
# - /detect-anomaly endpoint works normally (uses trained ML model)
